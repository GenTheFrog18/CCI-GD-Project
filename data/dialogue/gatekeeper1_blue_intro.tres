[ext_resource type="Script" uid="uid://c561kj13kn4li" path="res://data/definitions/dialogue_line.gd" id="1_line"]
[ext_resource type="Script" uid="uid://j8ks4377trg3" path="res://data/definitions/dialogue_sequence.gd" id="2_sequence"]
[ext_resource type="Texture2D" uid="uid://cfvf1bi1xlfsd" path="res://assets/art/characters/npc/portrait/Gatekeeper1.png" id="3_gatekeeper"]
[ext_resource type="Texture2D" uid="uid://d0p2emigwb3c7" path="res://assets/art/characters/player/Portrait_Flat.png" id="4_player"]
[ext_resource type="Script" uid="uid://b8t3tmjph4vjg" path="res://data/definitions/dialogue_step.gd" id="5_hhl0d"]

[sub_resource type="Resource" id="Line_01"]
script = ExtResource("1_line")
speaker_id = &"gatekeeper1"
speaker_name = "Gatekeeper"
text = "Ah peluit biru! ku anggap kamu disini untuk perjalanan pertama mu ke layer 2?"
portrait = ExtResource("3_gatekeeper")

[sub_resource type="Resource" id="Line_02"]
script = ExtResource("1_line")
speaker_id = &"elanara"
speaker_name = "Elanara"
text = "Yap! betul sekali, ku ingin pergi lebih dalam!"
portrait = ExtResource("4_player")

[sub_resource type="Resource" id="Line_03"]
script = ExtResource("1_line")
speaker_id = &"gatekeeper1"
speaker_name = "Gatekeeper"
text = "Baiklah, berhati-hati dibawah sana dan perhatikan langkahmu."
portrait = ExtResource("3_gatekeeper")

[sub_resource type="Resource" id="Line_04"]
script = ExtResource("1_line")
speaker_id = &"gatekeeper1"
speaker_name = "Gatekeeper"
text = "Jika perlu bantuan, penjaga outpost di barat mungkin bisa membantu."
portrait = ExtResource("3_gatekeeper")

[sub_resource type="Resource" id="Line_05"]
script = ExtResource("1_line")
speaker_id = &"elanara"
speaker_name = "Elanara"
text = "Baik! terimakasih, ku akan memberitahumu jika ada sesuatu yang keren dibawah sana!"
portrait = ExtResource("4_player")

[resource]
script = ExtResource("2_sequence")
sequence_id = &"gatekeeper1_blue_intro"
entries = Array[ExtResource("1_line")]([SubResource("Line_01"), SubResource("Line_02"), SubResource("Line_03"), SubResource("Line_04"), SubResource("Line_05")])
