script = ExtResource("1")
sequence_id = &"prologue_intro"
speaker = "..."
lines = PackedStringArray("Tidak ada yang tahu kapan Abyss pertama kali muncul.", "Tidak ada yang tahu seberapa dalam tempat ini membentang.", "Namun, semakin dalam seseorang menjelajah...", "...semakin banyak hal yang harus ia tinggalkan.", "Harta. Ingatan. Bahkan orang-orang yang paling ia sayangi.", "Mereka yang berani memasuki Abyss disebut Delver.", "Sebagian turun demi kekayaan.", "Sebagian turun demi jawaban.", "Dan sebagian lainnya turun...", "...karena seseorang yang mereka cari belum pernah kembali.", "Apa yang sebenarnya ada di bawah sana?")
locks_gameplay = true
