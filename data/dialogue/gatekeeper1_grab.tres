[sub_resource type="Resource" id="Line_01"]
script = ExtResource("1_line")
speaker_id = &"gatekeeper1"
speaker_name = "Gatekeeper"
text = "Hah, Tertangkap juga."
portrait = ExtResource("3_gatekeeper")

[sub_resource type="Resource" id="Line_02"]
script = ExtResource("1_line")
speaker_id = &"elenara"
speaker_name = "Elenara"
text = "Grr... Lepaskan aku!"
portrait = ExtResource("4_player")

[sub_resource type="Resource" id="Line_03"]
script = ExtResource("1_line")
speaker_id = &"gatekeeper1"
speaker_name = "Gatekeeper"
text = "Saatnya untukmu pulang ke atas lagi."
portrait = ExtResource("3_gatekeeper")

[sub_resource type="Resource" id="Line_04"]
script = ExtResource("1_line")
speaker_id = &"gatekeeper1"
speaker_name = "Gatekeeper"
text = "Delver merah sepertimu tidak memerlukan relik sebanyak ini. Akan kusimpan sampai kau memerlukannya lagi."
portrait = ExtResource("3_gatekeeper")

[resource]
script = ExtResource("2_sequence")
sequence_id = &"gatekeeper1_grab"
entries = Array[ExtResource("1_line")]([SubResource("Line_01"), SubResource("Line_02"), SubResource("Line_03"), SubResource("Line_04")])
