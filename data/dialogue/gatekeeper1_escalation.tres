[sub_resource type="Resource" id="Line_01"]
script = ExtResource("1_line")
speaker_id = &"gatekeeper1"
speaker_name = "Gatekeeper"
text = "Sudah kubilang, pulanglah keatas, kembali lagi jika kau sudah membuktikan kemampuanmu dengan peluit biru."
portrait = ExtResource("3_gatekeeper")

[sub_resource type="Resource" id="Line_02"]
script = ExtResource("1_line")
speaker_id = &"gatekeeper1"
speaker_name = "Gatekeeper"
text = "Jika kau masih keras kepala, kau harus melewati ku!"
portrait = ExtResource("3_gatekeeper")

[resource]
script = ExtResource("2_sequence")
sequence_id = &"gatekeeper1_escalation"
entries = Array[ExtResource("1_line")]([SubResource("Line_01"), SubResource("Line_02")])
