; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="CCI GD Project"
run/main_scene="res://ui/main_menu.tscn"
config/features=PackedStringArray("4.7")

[audio]

default_bus_layout="res://default_bus_layout.tres"

[autoload]

ContentCatalog="*res://autoload/content_catalog.gd"
GameSession="*res://autoload/game_session.gd"
SaveManager="*res://autoload/save_manager.gd"
SceneRouter="*res://autoload/scene_router.gd"

[debug]

gdscript/warnings/untyped_declaration=1

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[layer_names]

2d_physics/layer_1="World"
2d_physics/layer_2="Player"
2d_physics/layer_3="Enemy"
2d_physics/layer_4="WorldItem"
2d_physics/layer_5="PlayerPayload"
2d_physics/layer_6="EnemyPayload"
2d_physics/layer_7="Interactable"
2d_physics/layer_8="Sensor"
2d_physics/layer_9="SightObscurer"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
